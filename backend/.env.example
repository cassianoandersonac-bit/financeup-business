# PostgreSQL — use um banco novo, separado do FinanceUp pessoal
# (ex: outro projeto no Neon, neon.tech, free tier).
# No Neon, use a connection string "pooled" (host com "-pooler") aqui...
DATABASE_URL="postgresql://usuario:senha@host-pooler/financeup_business?sslmode=require&channel_binding=require"
# ...e a "direct" (sem "-pooler") aqui — só usada pelo Prisma Migrate,
# que precisa de conexão direta (PgBouncer não suporta bem migrations).
DIRECT_URL="postgresql://usuario:senha@host/financeup_business?sslmode=require&channel_binding=require"

# Gere uma chave forte, ex: openssl rand -hex 32
JWT_SECRET="troque-isso-em-producao"

PORT=3002
